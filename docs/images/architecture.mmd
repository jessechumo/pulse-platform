%%{init: {
  "theme": "base",
  "themeVariables": {
    "fontFamily": "Helvetica, Arial, sans-serif",
    "fontSize": "16px",
    "primaryColor": "#EEF2FA",
    "primaryBorderColor": "#3B5A85",
    "primaryTextColor": "#1F2937",
    "lineColor": "#64748B",
    "clusterBkg": "#FAFBFC",
    "clusterBorder": "#D0D7E2",
    "edgeLabelBackground": "#FFFFFF"
  }
}}%%
flowchart LR
    client(["Client"])

    subgraph cluster["Kubernetes cluster"]
        direction LR
        ingress@{ icon: "logos:nginx", form: "square", label: "Ingress", pos: "b" }

        subgraph app_layer["Application"]
            direction TB
            app@{ icon: "logos:fastapi-icon", form: "square", label: "pulse-app", pos: "b" }
            worker@{ icon: "logos:python", form: "square", label: "pulse-worker", pos: "b" }
        end

        subgraph obs["Observability"]
            direction TB
            prom@{ icon: "logos:prometheus", form: "square", label: "Prometheus", pos: "b" }
            grafana@{ icon: "logos:grafana", form: "square", label: "Grafana", pos: "b" }
            alertmgr["Alertmanager"]
        end

        subgraph data_layer["Data"]
            direction TB
            pg@{ icon: "logos:postgresql", form: "square", label: "Postgres", pos: "b" }
            redis@{ icon: "logos:redis", form: "square", label: "Redis", pos: "b" }
        end
    end

    client --> ingress --> app
    app -->|read / write| pg
    app -->|enqueue| redis
    redis -->|consume| worker
    worker -->|write| pg
    app -->|scrape| prom
    prom --> grafana
    prom -->|alert| alertmgr

    style client fill:#1F2937,stroke:#1F2937,color:#FFFFFF
