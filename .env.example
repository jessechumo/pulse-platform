# Copy to .env for running the app directly on the host (outside Docker
# Compose) against the Postgres/Redis containers' published ports.
# docker-compose.yml itself does not read this file for the app service --
# it points app at the containers' internal DNS names directly. Compose
# does auto-load .env for the ${VAR} substitutions in docker-compose.yml
# (POSTGRES_USER etc.), so keep those two in sync.
PULSE_ENVIRONMENT=development
PULSE_LOG_LEVEL=INFO
PULSE_DATABASE_URL=postgresql+asyncpg://pulse:pulse@localhost:5432/pulse
PULSE_REDIS_URL=redis://localhost:6379/0

POSTGRES_USER=pulse
POSTGRES_PASSWORD=pulse
POSTGRES_DB=pulse
